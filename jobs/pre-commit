#!/bin/sh
# Formats and tests the Go jobs module before allowing a commit that touches it.
# Installed via `git config core.hooksPath jobs`.
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

staged_files=$(git diff --cached --name-only --diff-filter=ACM)

if ! echo "$staged_files" | grep -q "^jobs/"; then
  exit 0
fi

echo "==> gofmt: jobs"
unformatted=$(gofmt -l jobs)
if [ -n "$unformatted" ]; then
  echo "gofmt found unformatted files:"
  echo "$unformatted"
  echo "Run: gofmt -w jobs"
  exit 1
fi

echo "==> go test: jobs"
(cd jobs && go test ./...)
