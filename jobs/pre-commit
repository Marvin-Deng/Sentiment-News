#!/bin/sh
# Formats and tests the Go jobs before allowing a commit that touches them.
# Installed via `git config core.hooksPath jobs`.
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

staged_files=$(git diff --cached --name-only --diff-filter=ACM)

go_modules=""
for mod_dir in jobs/news-ingest jobs/stock-price; do
  if echo "$staged_files" | grep -q "^$mod_dir/"; then
    go_modules="$go_modules $mod_dir"
  fi
done

if [ -z "$go_modules" ]; then
  exit 0
fi

for mod_dir in $go_modules; do
  echo "==> gofmt: $mod_dir"
  unformatted=$(gofmt -l "$mod_dir")
  if [ -n "$unformatted" ]; then
    echo "gofmt found unformatted files in $mod_dir:"
    echo "$unformatted"
    echo "Run: gofmt -w $mod_dir"
    exit 1
  fi

  echo "==> go test: $mod_dir"
  (cd "$mod_dir" && go test ./...)
done
