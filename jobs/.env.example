GCP_PROJECT_ID=
FINNHUB_API_KEY=
GEMINI_KEY=
TIINGO_TOKEN=

# Optional: comma-separated tickers (defaults to the full backend ticker list)
# TICKERS=AAPL,MSFT

# news-ingest only needs GCP_PROJECT_ID, FINNHUB_API_KEY, and GEMINI_KEY.
# stock-price only needs GCP_PROJECT_ID and TIINGO_TOKEN.
# Both jobs load this same .env file, so unused keys per-job are simply ignored.
